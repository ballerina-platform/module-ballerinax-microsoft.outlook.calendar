# A suggested meeting time, with attendee availability and locations
public type MeetingTimeSuggestion record {
    # An array that shows the availability status of each attendee for this meeting suggestion
    AttendeeAvailability[] attendeeAvailability?;
    # Availability of the meeting organizer for this meeting suggestion. The possible values are: free, tentative, busy, oof, workingElsewhere, unknown
    FreeBusyStatus|record {} organizerAvailability?;
    # The OData type annotation identifying the entity or complex type of the object
    @jsondata:Name {value: "@odata.type"}
    string atOdataType?;
    # A percentage that represents the likelhood of all the attendees attending
    decimal|string|ReferenceNumeric? confidence?;
    # An array that specifies the name and geographic location of each meeting location for this meeting suggestion
    Location[] locations?;
    # A time period suggested for the meeting
    TimeSlot|record {} meetingTimeSlot?;
    # Order of meeting time suggestions sorted by their computed confidence value from high to low, then by chronology if there are suggestions with the same confidence
    decimal? 'order?;
    # Reason for suggesting the meeting time
    string? suggestionReason?;
};

# An upload session for uploading a large attachment in ranges
public type UploadSession record {
    # The date and time in UTC that the upload session expires. The complete file must be uploaded before this expiration time is reached. Each fragment uploaded during the session extends the expiration time
    string? expirationDateTime?;
    # The URL endpoint that accepts PUT requests for byte ranges of the file
    string? uploadUrl?;
    # The OData type annotation identifying the entity or complex type of the object
    @jsondata:Name {value: "@odata.type"}
    string atOdataType?;
    # A collection of byte ranges that the server is missing for the file. These ranges are zero indexed and of the format 'start-end' (for example '0-26' to indicate the first 27 bytes of the file). When uploading files as Outlook attachments, instead of a collection of ranges, this property always indicates a single value '{start}', the location in the file where the next upload should begin
    string[] nextExpectedRanges?;
};

# Request body for declining an event
public type DeclineEventRequest record {
    # Text included in the response to the organizer
    @jsondata:Name {value: "Comment"}
    string? comment?;
    # Whether to send a response to the organizer; defaults to true
    @jsondata:Name {value: "SendResponse"}
    boolean? sendResponse = false;
    # Alternative date and time proposed to the organizer for the meeting
    @jsondata:Name {value: "ProposedNewTime"}
    TimeSlot|record {} proposedNewTime?;
};

